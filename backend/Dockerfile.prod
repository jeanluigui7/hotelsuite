# Backend — build de producción (multi-stage)
FROM node:20-alpine AS build
WORKDIR /app
RUN apk add --no-cache openssl
COPY package*.json ./
RUN npm install
COPY . .
RUN npx prisma generate && npm run build

FROM node:20-alpine AS runtime
WORKDIR /app
# tzdata: necesario para que TZ (hora de Perú) funcione en Alpine; las salidas de
# pernoctación se calculan en hora local del hotel (no UTC).
RUN apk add --no-cache openssl tzdata
ENV NODE_ENV=production
ENV TZ=America/Lima
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/prisma ./prisma
# src y tsconfig: el seed base (prisma/seed.ts) importa desde src/shared/rbac vía tsx.
COPY --from=build /app/src ./src
COPY --from=build /app/tsconfig.json ./tsconfig.json
COPY --from=build /app/package.json ./package.json
EXPOSE 3000
# Aplica migraciones pendientes y siembra datos base + ropa por sucursal (idempotente).
# Estos pasos son NO-FATALES: si fallan (p. ej. la BD temporalmente inaccesible o sin espacio),
# el servidor arranca igual y sirve — evita un crash-loop del backend por un problema de la BD.
CMD ["sh", "-c", "npx prisma migrate deploy || echo 'WARN: migrate deploy fallo, se continua'; npx prisma db seed || echo 'WARN: db seed fallo'; npx tsx prisma/seed-linen.ts || echo 'WARN: seed-linen fallo'; node dist/server.js"]
